{# Rendered to {{ opensight_dir }}/.env, mode 0600 — the app/worker containers
   load it via `env_file:` in compose.yml. Every var here is read by
   internal/config/config.go (LoadFromEnv); names must match exactly. #}
# Managed by Ansible (infra/roles/app/templates/env.j2). Do not edit by hand —
# changes are overwritten on the next `make infra-deploy`.

# critical: config.go gates SecureCookies on Env != "dev". Anything other than
# "production" here ships session cookies without Secure.
OPENSIGHT_ENV=production

# The Google OAuth redirect URI and every Stripe return URL are derived from
# this (cmd/opensight/main.go, internal/api/billing_rpc.go).
APP_BASE_URL=https://{{ domain }}

DATABASE_URL=postgres://opensight:{{ postgres_password }}@postgres:5432/opensight?sslmode=disable
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=opensight

# Default is "stub", which would silently fake every run.
PROMPT_RUNNER_MODE=openai

OPENAI_API_KEY={{ openai_api_key }}

STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
STRIPE_PRICE_STARTER_MONTHLY={{ stripe_price_starter_monthly }}
STRIPE_PORTAL_CONFIGURATION_ID={{ stripe_portal_configuration_id }}

GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
