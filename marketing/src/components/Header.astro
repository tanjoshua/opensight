---
const currentPath = Astro.url.pathname;
const productsCurrent = currentPath === "/monitor/" || currentPath === "/improve/";
const isCurrent = (path: string) => currentPath === path;
const mobileLinkClass = (path: string) => [
  "rounded-xl px-3 py-3 font-medium no-underline",
  isCurrent(path) ? "bg-paper" : "hover:bg-paper",
];
---

<header class="site-header" id="site-header">
  <div class="site-shell flex h-16 items-center justify-between gap-5">
    <a href="/" aria-label="OpenSight home" class="flex items-center gap-2.5 no-underline">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="font-display text-[1.18rem] font-extrabold tracking-[-0.035em]">OpenSight</span>
    </a>
    <nav class="hidden items-center gap-7 text-[0.92rem] font-medium md:flex" aria-label="Main navigation">
      <div class="relative" id="products-menu">
        <button
          type="button"
          data-menu-trigger
          class:list={[productsCurrent ? "nav-link-current" : "nav-link", "flex cursor-pointer items-center gap-1.5 bg-transparent font-medium"]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="products-panel"
        >
          Products
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div id="products-panel" data-menu-panel hidden class="nav-panel">
          <a href="/monitor/" class:list={["nav-panel-item", { "bg-paper": isCurrent("/monitor/") }]} aria-current={isCurrent("/monitor/") ? "page" : undefined}>
            <span class="nav-panel-icon" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 15 4-5 3 2 5-7"></path></svg></span>
            <span>
              <strong class="text-ink block text-[0.95rem]">Monitor</strong>
              <span class="text-moss block text-[0.84rem] leading-snug">What ChatGPT says about you, who it names instead, and the sources behind it.</span>
            </span>
          </a>
          <a href="/improve/" class:list={["nav-panel-item", { "bg-paper": isCurrent("/improve/") }]} aria-current={isCurrent("/improve/") ? "page" : undefined}>
            <span class="nav-panel-icon" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V7"></path><path d="m6 13 6-6 6 6"></path></svg></span>
            <span>
              <strong class="text-ink block text-[0.95rem]">Improve</strong>
              <span class="text-moss block text-[0.84rem] leading-snug">A ranked list of what to fix, drawn from your site and your answers.</span>
            </span>
          </a>
        </div>
      </div>
      <a href="/pricing/" class={isCurrent("/pricing/") ? "nav-link-current" : "nav-link"} aria-current={isCurrent("/pricing/") ? "page" : undefined}>Pricing</a>
      <a href="/faq/" class={isCurrent("/faq/") ? "nav-link-current" : "nav-link"} aria-current={isCurrent("/faq/") ? "page" : undefined}>FAQ</a>
    </nav>
    <div class="hidden items-center gap-4 md:flex">
      <a href="https://dashboard.opensight.app" class="nav-link text-[0.92rem] font-medium">Sign in</a>
      <a href="https://dashboard.opensight.app/signup" class="button-primary min-h-10 px-4 py-2 text-[0.88rem]">Check my visibility <span aria-hidden="true">↗</span></a>
    </div>
    <button id="nav-toggle" type="button" class="border-line grid size-10 place-items-center rounded-full border bg-white md:hidden" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
      <svg class="nav-open-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 8h14M5 16h14"></path></svg>
      <svg class="nav-close-icon hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <nav id="nav-menu" hidden class="border-line border-t bg-white px-5 py-5 md:hidden" aria-label="Mobile navigation">
    <div class="mx-auto grid max-w-[1200px] gap-1">
      <p class="stat-label px-3 pt-1 pb-2">Products</p>
      <a href="/monitor/" class:list={mobileLinkClass("/monitor/")} aria-current={isCurrent("/monitor/") ? "page" : undefined}>Monitor <span class="text-moss block text-[0.82rem] font-normal">Measure your AI visibility</span></a>
      <a href="/improve/" class:list={mobileLinkClass("/improve/")} aria-current={isCurrent("/improve/") ? "page" : undefined}>Improve <span class="text-moss block text-[0.82rem] font-normal">Fix what keeps you out of answers</span></a>
      <p class="stat-label px-3 pt-3 pb-2">Company</p>
      <a href="/pricing/" class:list={mobileLinkClass("/pricing/")} aria-current={isCurrent("/pricing/") ? "page" : undefined}>Pricing</a>
      <a href="/faq/" class:list={mobileLinkClass("/faq/")} aria-current={isCurrent("/faq/") ? "page" : undefined}>FAQ</a>
      <a href="https://dashboard.opensight.app" class="text-moss rounded-xl px-3 py-3 font-medium no-underline hover:bg-paper">Sign in</a>
      <a href="https://dashboard.opensight.app/signup" class="button-primary mt-3">Check my visibility <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
