#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${OPENSIGHT_COMPOSE_FILE:-compose.dev.yml}"
POSTGRES_WAIT_ATTEMPTS="${POSTGRES_WAIT_ATTEMPTS:-60}"
API_WAIT_ATTEMPTS="${API_WAIT_ATTEMPTS:-30}"
FRONTEND_WAIT_ATTEMPTS="${FRONTEND_WAIT_ATTEMPTS:-30}"
# Keep the browser origin identical to APP_BASE_URL. OAuth state cookies are
# host-scoped, so starting on 127.0.0.1 and returning from Google to localhost
# drops the cookie even though both names resolve to the local machine.
FRONTEND_HOST="${FRONTEND_HOST:-localhost}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
MARKETING_WAIT_ATTEMPTS="${MARKETING_WAIT_ATTEMPTS:-30}"
RIVER_UI_WAIT_ATTEMPTS="${RIVER_UI_WAIT_ATTEMPTS:-30}"
RIVER_UI_URL="${RIVER_UI_URL:-http://127.0.0.1:8082}"

cd "$ROOT_DIR"

pids=()

log() {
  printf '==> %s\n' "$*"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '%s is required for make up.\n' "$1" >&2
    exit 127
  fi
}

cleanup() {
  status=$?
  trap - EXIT INT TERM

  if [ "${#pids[@]}" -gt 0 ]; then
    log "stopping app and frontend processes"
    kill "${pids[@]}" >/dev/null 2>&1 || true
    wait "${pids[@]}" >/dev/null 2>&1 || true
  fi

  exit "$status"
}

wait_for_postgres() {
  log "waiting for Postgres"

  for _ in $(seq 1 "$POSTGRES_WAIT_ATTEMPTS"); do
    if docker compose -f "$COMPOSE_FILE" exec -T postgres pg_isready -U opensight -d opensight >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done

  docker compose -f "$COMPOSE_FILE" logs --tail=80 postgres >&2 || true
  printf 'Postgres did not become ready within %s seconds.\n' "$POSTGRES_WAIT_ATTEMPTS" >&2
  return 1
}

wait_for_river_ui() {
  log "waiting for River UI at $RIVER_UI_URL"

  for _ in $(seq 1 "$RIVER_UI_WAIT_ATTEMPTS"); do
    if curl -fsS "$RIVER_UI_URL/api/health-checks/complete" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done

  docker compose -f "$COMPOSE_FILE" logs --tail=80 riverui >&2 || true
  printf 'River UI did not become ready within %s seconds.\n' "$RIVER_UI_WAIT_ATTEMPTS" >&2
  return 1
}

api_base_url() {
  if [ -n "${OPENSIGHT_API_URL:-}" ]; then
    printf '%s\n' "${OPENSIGHT_API_URL%/}"
    return
  fi

  http_addr="${HTTP_ADDR:-:8080}"
  case "$http_addr" in
    :*)
      printf 'http://127.0.0.1%s\n' "$http_addr"
      ;;
    0.0.0.0:*)
      printf 'http://127.0.0.1:%s\n' "${http_addr##*:}"
      ;;
    "[::]:"*)
      printf 'http://127.0.0.1:%s\n' "${http_addr##*:}"
      ;;
    *)
      printf 'http://%s\n' "$http_addr"
      ;;
  esac
}

api_health_url() {
  if [ -n "${OPENSIGHT_HEALTH_URL:-}" ]; then
    printf '%s\n' "$OPENSIGHT_HEALTH_URL"
    return
  fi

  printf '%s/healthz\n' "$(api_base_url)"
}

frontend_enabled() {
  [ -f web/package.json ]
}

marketing_enabled() {
  [ -f marketing/package.json ]
}

frontend_link_host() {
  case "$FRONTEND_HOST" in
    "" | 0.0.0.0 | "::" | "[::]")
      printf '127.0.0.1\n'
      ;;
    *)
      printf '%s\n' "$FRONTEND_HOST"
      ;;
  esac
}

frontend_url() {
  printf 'http://%s:%s\n' "$(frontend_link_host)" "$FRONTEND_PORT"
}

marketing_url() {
  printf 'http://127.0.0.1:8081\n'
}

check_processes_running() {
  for pid in "${pids[@]}"; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      if wait "$pid"; then
        status=0
      else
        status=$?
      fi
      printf 'A dev process exited early with status %s.\n' "$status" >&2
      return 1
    fi
  done

  return 0
}

wait_for_api() {
  health_url="$(api_health_url)"
  log "waiting for API at $health_url"

  for _ in $(seq 1 "$API_WAIT_ATTEMPTS"); do
    if curl -fsS "$health_url" >/dev/null 2>&1; then
      return 0
    fi
    check_processes_running
    sleep 1
  done

  printf 'API did not pass its health check within %s seconds.\n' "$API_WAIT_ATTEMPTS" >&2
  return 1
}

wait_for_frontend() {
  if ! frontend_enabled; then
    return 0
  fi

  url="$(frontend_url)"
  log "waiting for frontend at $url"

  for _ in $(seq 1 "$FRONTEND_WAIT_ATTEMPTS"); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    check_processes_running
    sleep 1
  done

  printf 'Frontend did not respond within %s seconds.\n' "$FRONTEND_WAIT_ATTEMPTS" >&2
  return 1
}

wait_for_marketing() {
  if ! marketing_enabled; then
    return 0
  fi

  url="$(marketing_url)"
  log "waiting for marketing site at $url"

  for _ in $(seq 1 "$MARKETING_WAIT_ATTEMPTS"); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    check_processes_running
    sleep 1
  done

  printf 'Marketing site did not respond within %s seconds.\n' "$MARKETING_WAIT_ATTEMPTS" >&2
  return 1
}

ensure_api_not_already_running() {
  health_url="$(api_health_url)"
  if curl -fsS "$health_url" >/dev/null 2>&1; then
    printf 'An API is already responding at %s. Stop it before running make up.\n' "$health_url" >&2
    return 1
  fi
}

wait_for_process_exit() {
  while true; do
    for pid in "${pids[@]}"; do
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        if wait "$pid"; then
          return 0
        else
          status=$?
          return "$status"
        fi
      fi
    done
    sleep 1
  done
}

start_processes() {
  log "starting app with reload"
  go tool air -c .air.serve.toml &
  pids+=("$!")

  if frontend_enabled; then
    require_command npm
    log "starting frontend dev server"
    (cd web && npm run dev -- --host "$FRONTEND_HOST" --port "$FRONTEND_PORT" --strictPort) &
    pids+=("$!")
  fi

  if marketing_enabled; then
    require_command npm
    log "starting marketing dev server"
    (cd marketing && npm run dev -- --host 127.0.0.1) &
    pids+=("$!")
  fi
}

print_service_links() {
  printf '\nService links:\n'
  printf '  API:         %s\n' "$(api_base_url)"
  printf '  API health:  %s\n' "$(api_health_url)"

  if frontend_enabled; then
    printf '  Frontend:    %s\n' "$(frontend_url)"
  fi

  if marketing_enabled; then
    printf '  Marketing:   %s\n' "$(marketing_url)"
  fi

  printf '  River UI:    %s\n' "$RIVER_UI_URL"

  printf '\n'
}

trap cleanup EXIT INT TERM

require_command docker
require_command go
require_command curl

if ! docker compose version >/dev/null 2>&1; then
  printf 'docker compose is required for make up.\n' >&2
  exit 127
fi

log "starting local infrastructure"
docker compose -f "$COMPOSE_FILE" up -d postgres

wait_for_postgres

log "running database migrations"
go run ./cmd/opensight migrate

log "starting River UI"
docker compose -f "$COMPOSE_FILE" up -d riverui
wait_for_river_ui

ensure_api_not_already_running
start_processes
wait_for_api
wait_for_frontend
wait_for_marketing
print_service_links

log "App is healthy; press Ctrl+C to stop app, frontend, and marketing"
wait_for_process_exit
