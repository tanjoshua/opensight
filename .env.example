# Copy to .env and fill in. See docs/design/08-billing.md → "Config and secrets".
# Use a project-scoped OpenAI key with a monthly budget cap set in the OpenAI dashboard.
OPENAI_API_KEY=

# stripe — leave BILLING_PROVIDER unset (defaults to stub) for local dev; see docs/dev.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
APP_BASE_URL=
BILLING_PROVIDER=
