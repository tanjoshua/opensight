# Copy to .env and fill in. See docs/design/08-billing.md → "Config and secrets".
# Use a project-scoped OpenAI key with a monthly budget cap set in the OpenAI dashboard.
OPENAI_API_KEY=

# Stripe sandbox locally; a restricted live key in production. See docs/dev.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
# Pre-provisioned per Stripe environment; used by portal-config and serve.
STRIPE_PORTAL_CONFIGURATION_ID=
# Required in every environment; use http://localhost:5173 for local development.
APP_BASE_URL=http://localhost:5173

# Google OAuth client (design 07 "Auth and accounts") — the sole sign-in
# method. Create a Web application client in Google Cloud Console and add
# {APP_BASE_URL}/auth/google/callback (http://localhost:5173/auth/google/callback
# locally) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
